<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Framecards — Lomocards & Fanmade Store ✨</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'%3E%3Crect width='120' height='120' rx='24' fill='%234E1114'/%3E%3Ctext x='28' y='74' font-family='Georgia, serif' font-size='56' fill='%23B92B27'%3EF%3C/text%3E%3Ctext x='46' y='88' font-family='Georgia, serif' font-size='54' fill='%23992222'%3EC%3C/text%3E%3C/svg%3E" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            serif: ['Cormorant Garamond', 'serif'],
            script: ['Alex Brush', 'cursive'],
          },
          colors: {
            bordo: {
              950: '#35090B',
              900: '#4E1114',
              800: '#69171B',
              700: '#851D22',
            }
          }
        }
      }
    }
  </script>
  <style>
    .starry-bg {
      background-color: #4E1114;
      background-image:
        radial-gradient(1.5px 1.5px at 14% 18%, rgba(255,255,255,0.85) 50%, transparent 100%),
        radial-gradient(2px 2px at 28% 72%, rgba(255,235,235,0.75) 50%, transparent 100%),
        radial-gradient(1.2px 1.2px at 42% 28%, rgba(255,255,255,0.6) 50%, transparent 100%),
        radial-gradient(2.2px 2.2px at 64% 16%, rgba(255,245,245,0.9) 50%, transparent 100%),
        radial-gradient(1.5px 1.5px at 78% 64%, rgba(255,255,255,0.7) 50%, transparent 100%),
        radial-gradient(1.8px 1.8px at 88% 34%, rgba(255,230,230,0.8) 50%, transparent 100%),
        radial-gradient(1.2px 1.2px at 22% 45%, rgba(255,255,255,0.5) 50%, transparent 100%),
        radial-gradient(2px 2px at 54% 84%, rgba(255,240,240,0.85) 50%, transparent 100%),
        radial-gradient(1.4px 1.4px at 92% 82%, rgba(255,255,255,0.65) 50%, transparent 100%);
    }

    .card-fan-wrap {
      perspective: 900px;
    }
    .lomo-card {
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
    }
    .product-card:hover .lomo-left {
      transform: translateX(-22px) rotate(-14deg) translateY(-4px);
    }
    .product-card:hover .lomo-center {
      transform: translateY(-8px) scale(1.04);
    }
    .product-card:hover .lomo-right {
      transform: translateX(22px) rotate(14deg) translateY(-4px);
    }

    .holo-sheen {
      background: linear-gradient(125deg, rgba(255,255,255,0) 20%, rgba(255,220,225,0.45) 48%, rgba(255,255,255,0.15) 55%, rgba(255,255,255,0) 80%);
    }

    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #FFF5F5;
    }
    ::-webkit-scrollbar-thumb {
      background: #991B1B;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="bg-[#FFF9F9] text-stone-900 antialiased selection:bg-red-700 selection:text-white">

  <!-- Top Announcement Bar -->
  <div class="bg-[#35090B] text-red-100 text-xs sm:text-sm py-2 px-4 text-center font-medium border-b border-red-900/50">
    ✨ <span class="font-semibold text-white">Free Shipping</span> on orders over R$ 80.00 • 10% OFF Promo Code: <button onclick="quickCopyCoupon()" class="underline decoration-red-400 font-bold text-white hover:text-red-200 cursor-pointer">FRAMECARDS10</button> • In Stock & Pre-Order
  </div>

  <!-- Sticky Header -->
  <header class="sticky top-0 z-40 bg-[#4E1114]/95 backdrop-blur-md border-b border-red-900/60 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      <!-- Brand & Official Logo -->
      <a href="#" class="flex items-center gap-3 group shrink-0">
        <div class="w-14 h-14 rounded-xl overflow-hidden border border-red-400/30 shadow-md shrink-0 bg-[#4E1114]">
          <!-- Official FC kpop + Jellyfish SVG Logo -->
          <svg viewBox="0 0 200 200" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
            <rect width="200" height="200" fill="#4E1114"/>
            <g fill="#FFFFFF" opacity="0.85">
              <circle cx="28" cy="24" r="1.5"/><circle cx="72" cy="18" r="1.2"/><circle cx="148" cy="22" r="1.6"/>
              <circle cx="176" cy="48" r="1.4"/><circle cx="22" cy="86" r="1.3"/><circle cx="168" cy="112" r="1.5"/>
              <circle cx="34" cy="156" r="1.6"/><circle cx="94" cy="178" r="1.3"/><circle cx="164" cy="168" r="1.7"/>
              <circle cx="115" cy="36" r="1.1"/><circle cx="52" cy="128" r="1.2"/><circle cx="142" cy="144" r="1.1"/>
            </g>
            <!-- Delicate Jellyfish -->
            <g stroke="#E13B3B" stroke-width="1.35" fill="none" stroke-linecap="round" opacity="0.92">
              <path d="M118 52 C118 38, 138 36, 141 50 C134 53, 124 54, 118 52 Z"/>
              <path d="M121 48 C126 45, 133 45, 138 48" stroke-width="0.9"/>
              <path d="M122 53 C120 62, 127 68, 124 77"/>
              <path d="M126 53 C127 63, 133 69, 131 79"/>
              <path d="M130 53 C133 61, 139 67, 138 76"/>
              <path d="M134 52 C139 60, 144 65, 143 74"/>
              <path d="M137 51 C143 57, 147 63, 146 71"/>
            </g>
            <!-- Monogram F -->
            <text x="58" y="126" font-family="Cormorant Garamond, Georgia, serif" font-weight="600" font-size="96" fill="#B62B27">F</text>
            <!-- Monogram C -->
            <text x="76" y="144" font-family="Cormorant Garamond, Georgia, serif" font-weight="600" font-size="88" fill="#A63434" opacity="0.92">C</text>
            <!-- Script kpop -->
            <text x="102" y="122" font-family="Alex Brush, cursive" font-size="30" fill="#E53935">kpop</text>
          </svg>
        </div>
        <div>
          <span class="block text-xl sm:text-2xl font-extrabold tracking-tight text-white leading-none">Framecards</span>
          <span class="block text-[11px] sm:text-xs text-red-200 font-medium mt-0.5">Lomocards & Fanmade Store ✨</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-red-100">
        <a href="#catalog" onclick="setAvailabilityFilter('ALL')" class="hover:text-white transition">Catalog</a>
        <a href="#catalog" onclick="setAvailabilityFilter('pronta')" class="hover:text-white transition flex items-center gap-1">In Stock <span class="text-xs">🔥</span></a>
        <a href="#catalog" onclick="setAvailabilityFilter('encomenda')" class="hover:text-white transition flex items-center gap-1">Pre-Order <span class="text-xs">✨</span></a>
        <a href="#faq" class="hover:text-white transition">FAQ</a>
      </nav>

      <!-- Right Actions -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <a href="https://instagram.com/frameecards" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-red-100 hover:text-white bg-red-950/60 hover:bg-red-900/70 border border-red-400/25 px-3 py-2 rounded-full transition">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          @frameecards
        </a>

        <button onclick="openCart()" class="relative inline-flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white font-bold text-sm px-4 py-2.5 rounded-full shadow-md shadow-red-950/40 transition cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span class="hidden sm:inline">Bag</span>
          <span id="cart-badge" class="bg-white text-red-700 text-xs font-extrabold px-2 py-0.5 rounded-full">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Starry Burgundy Hero Section -->
  <section class="starry-bg text-white relative overflow-hidden border-b border-red-900/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Main Copy -->
        <div class="lg:col-span-7 text-center lg:text-left space-y-6">
          <div class="inline-flex items-center gap-2 bg-red-950/80 border border-red-400/30 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-red-200">
            <span>📸 300gsm Coated Paper • High Definition</span>
            <span class="text-red-400">•</span>
            <span>8.6 × 5.4 cm</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
            Complete your binder with <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-300 via-rose-200 to-red-400">perfect lomocards</span> ✨
          </h1>

          <p class="text-red-100/90 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed">
            Exclusive 55-card packs, holographic sets, and polaroids of your favorite groups. Choose between <strong>In Stock</strong> or <strong>Pre-Order</strong> and complete your order directly via WhatsApp or Instagram!
          </p>

          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2">
            <a href="#catalog" onclick="setAvailabilityFilter('ALL')" class="bg-red-600 hover:bg-red-500 text-white font-bold px-7 py-3.5 rounded-full shadow-lg shadow-red-950/50 transition text-sm sm:text-base">
              Browse Full Catalog
            </a>
            <button onclick="setAvailabilityFilter('pronta'); document.getElementById('catalog').scrollIntoView({behavior:'smooth'})" class="bg-emerald-600/90 hover:bg-emerald-500 text-white font-bold px-5 py-3.5 rounded-full transition text-sm sm:text-base cursor-pointer">
              🔥 In Stock
            </button>
            <button onclick="setAvailabilityFilter('encomenda'); document.getElementById('catalog').scrollIntoView({behavior:'smooth'})" class="bg-amber-600/90 hover:bg-amber-500 text-white font-bold px-5 py-3.5 rounded-full transition text-sm sm:text-base cursor-pointer">
              ✨ Pre-Order
            </button>
          </div>
        </div>

        <!-- Featured Official Logo Card -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative bg-[#4E1114] border-2 border-red-400/30 rounded-3xl p-4 shadow-2xl shadow-black/50 max-w-xs w-full">
            <div class="aspect-square w-full rounded-2xl
  
